{
  "name": "flip-wars",
  "private": true,
  "version": "1.0.0",
  "description": "땅따먹기 대작전 - 대포로 공을 쏴서 상대 땅을 내 색으로 뒤집는 모바일 게임",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
